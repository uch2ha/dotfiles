{
  "$schema": "https://opencode.ai/config.json",
  // ----- model and agent -----
  "default_agent": "plan",
  "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
  "agents": {
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4-pro-0813", //  medium+
      "color": "#38bdf8"
    },
    "build": {
      "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
      "color": "#ff7a00"
    },
    "architect": {
      "description": "Heavy architecture planning: migrations, redesigns, risky decisions",
      "model": "openrouter/anthropic/claude-sonnet-5.5", // expensive
      "color": "#CE2029",
      "hidden": true
    },
    // ---
    "general": {
      "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
      "mode": "subagent"
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017", // cheap
      "mode": "subagent"
    },
    // ---
    "compaction": {
      "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
      "mode": "subagent"
    },
    "summary": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017", // cheap
      "mode": "subagent"
    },
    "title": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017" // cheap
    }
  },
  // ----- plugins -----
  "plugins": [
    "@dietrichgebert/ponytail", // simplest-working-solution enforcer
    "superpowers@git+https://github.com/obra/superpowers.git", // skill system (brainstorming, plans, reviews)
    // "context-mode", // searchable memory across sessions, better context management
    "@upstash/context7-opencode" // Context7 MCP for current library documentation and code examples
  ],
  // ----- mcp -----
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app" // GitHub Grep MCP, search code examples on public GitHub repos
      }
    }
  },
  // ----- permissions -----
  "permissions": [
    // custom
    { "action": "gh_grep_*", "resource": "*", "effect": "allow" },
    // default
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "command *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" }
  ]
}
