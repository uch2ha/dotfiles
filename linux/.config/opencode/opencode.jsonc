{
  "$schema": "https://opencode.ai/config.json",
  // ----- model and agent -----
  "default_agent": "plan",
  "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
  "agents": {
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4-pro-0813", //  medium+
      "color": "#38bdf8"
    },
    "build": {
      "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
      "color": "#ff7a00"
    },
    "architect": {
      "description": "Heavy architecture planning: migrations, redesigns, risky decisions",
      "model": "openrouter/anthropic/claude-sonnet-5.5", // expensive
      "color": "#CE2029",
      "hidden": true
    },
    // ---
    "general": {
      "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
      "mode": "subagent"
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017", // cheap
      "mode": "subagent"
    },
    // ---
    "compaction": {
      "model": "openrouter/anthropic/claude-haiku-5.5", // medium-
      "mode": "subagent"
    },
    "summary": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017", // cheap
      "mode": "subagent"
    },
    "title": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017" // cheap
    }
  },
  // ----- plugins -----
  "plugins": [
    "@dietrichgebert/ponytail", // simplest-working-solution enforcer
    "superpowers@git+https://github.com/obra/superpowers.git", // skill system (brainstorming, plans, reviews)
    // "context-mode", // searchable memory across sessions, better context management
    "@upstash/context7-opencode" // Context7 MCP for current library documentation and code examples
  ],
  // ----- mcp -----
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app" // GitHub Grep MCP, search code examples on public GitHub repos
      }
    }
  },
  // ----- permissions -----
  "permissions": [
    // base: allow shell by default, ask for external dirs
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },

    // custom MCP
    { "action": "gh_grep_*", "resource": "*", "effect": "allow" },

    // secrets: ask before reading env files
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },

    // git: remote and destructive history operations
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "deny" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "deny" },

    // git: working tree changes
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout .", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git merge *", "effect": "ask" },
    { "action": "shell", "resource": "git rm *", "effect": "ask" },

    // filesystem: deletion and permission changes
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs *", "effect": "deny" },
    { "action": "shell", "resource": "shred *", "effect": "deny" },

    // system: privilege escalation, processes, power
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "killall *", "effect": "ask" },
    { "action": "shell", "resource": "shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "reboot *", "effect": "deny" },
    { "action": "shell", "resource": "poweroff *", "effect": "deny" }
  ]
}
